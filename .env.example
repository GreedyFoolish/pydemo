# web服务配置
WEB_APP_NAME=fastapi web服务

# 数据库配置
# 数据库主机
DB_HOST=localhost
# 数据库端口
DB_PORT=5432
# 数据库名称
DB_NAME=web_service
# 连接账号
DB_USER=admin
# 连接密码
DB_PASSWORD=123123

# 跨域配置
# 允许的源（白名单），JSON 数组格式，["*"] 表示允许所有
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
# 允许的 HTTP 方法，JSON 数组格式，["*"] 表示允许所有
CORS_METHODS=["GET","POST","PUT","DELETE","PATCH","OPTIONS"]
# 允许的请求头，JSON 数组格式，["*"] 表示允许所有
CORS_HEADERS=["Content-Type","Authorization","X-Request-ID","X-Process-Time"]
# 是否允许携带凭证（Cookie 等）
CORS_CREDENTIALS=true
# 暴露给前端的响应头，JSON 数组格式
CORS_EXPOSE_HEADERS=["X-Request-ID","X-Process-Time"]

# 认证授权配置
# JWT 签名密钥，生产环境请使用强随机字符串
AUTH_SECRET_KEY=58c04ea604040713909862fb9a81f821f16e31a3b8151b3ced27d8a23eff819b

# 日志配置
# 日志级别：TRACE / DEBUG / INFO / SUCCESS / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# 慢查询的警告阈值，单位毫秒
LOG_SLOW_QUERY_THRESHOLD=200

# AI 大模型配置（用于聊天、文本生成等场景）
# 大模型 API Key，从对应平台控制台获取
AI_API_KEY=
# API 端点地址，不同厂商不同：DeepSeek 为 https://api.deepseek.com
AI_BASE_URL=https://api.deepseek.com
# 默认使用的模型名称，如 deepseek-v4-flash / deepseek-chat / gpt-4o-mini
AI_MODEL=deepseek-v4-flash